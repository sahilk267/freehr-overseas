# -----------------------------------------------------------------------------
# FreelanceHR Production & Development Environment Variable Template
# -----------------------------------------------------------------------------
# Copy this file to .env and configure values before starting the application.
# Never commit actual secret keys or credentials to version control.

# =============================================================================
# Core Database & Runtime Configuration
# =============================================================================
# MySQL connection string (Required in all production modes; fallback to mock store in dev only)
DATABASE_URL=mysql://freelancehr_user:db_password@localhost:3306/freelancehr_db

# Runtime environment (production | development | test)
NODE_ENV=development

# Server port (container listens on 3000)
PORT=3000

# Canonical public base URL of the deployment (must be HTTPS in production)
APP_BASE_URL=https://recruiter.overseasjob.in

# Application host URL for self-referential links, OAuth, and assets
APP_URL=https://recruiter.overseasjob.in

# Primary owner identity for bootstrapping permissions and pilot access
PRIMARY_OWNER_EMAIL=mohd.aziz.sk@gmail.com
PRIMARY_OWNER_OPEN_ID=

# Restrict all app actions to the primary owner during pilot testing (true | false)
OWNER_ONLY_MODE=false

# =============================================================================
# Authentication (OIDC / SSO & Preview OAuth)
# =============================================================================
# Auth mode: "oidc" for production IdP; default fallback to preview OAuth in dev
AUTH_MODE=oidc

# OpenID Connect Provider details (Required when AUTH_MODE=oidc)
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-oidc-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_REDIRECT_URI=https://recruiter.overseasjob.in/api/auth/oidc/callback

# HS256 JWT session cookie signing secret (Must be at least 32 random characters)
SESSION_SECRET=your-secure-random-32-character-session-secret-here

# Preview OAuth settings (used in development environments)
OAUTH_SERVER_URL=
JWT_SECRET=

# =============================================================================
# Document Storage (Private Storage Engine)
# =============================================================================
# Storage mode: "local" (Hostinger local directory), "s3" (AWS/MinIO/Cloudflare), or "managed"
PRIVATE_STORAGE_MODE=local

# Local storage path outside public web root (Required when PRIVATE_STORAGE_MODE=local)
PRIVATE_LOCAL_STORAGE_PATH=/home/username/freelancehr-private-storage

# S3-compatible storage settings (Required when PRIVATE_STORAGE_MODE=s3)
STORAGE_BUCKET=freelancehr-private-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

# =============================================================================
# Email & Communications (Hostinger Mail API & Webhooks)
# =============================================================================
# Order-scoped Hostinger API token for transactional outbound delivery
HOSTINGER_MAIL_API_TOKEN=

# Hostinger sending domain (must match verified MX and SPF records)
HOSTINGER_MAIL_FROM_DOMAIN=overseasjob.in

# Mailbox resource IDs on Hostinger for organizational routing
HOSTINGER_MAILBOX_OWNER_ID=
HOSTINGER_MAILBOX_CLIENTS_ID=
HOSTINGER_MAILBOX_TALENT_ID=
HOSTINGER_MAILBOX_INTERVIEWS_ID=
HOSTINGER_MAILBOX_FINANCE_ID=
HOSTINGER_MAILBOX_PRIVACY_ID=

# Secret token required to authenticate inbound email webhooks
HOSTINGER_MAIL_WEBHOOK_SECRET=your-inbound-webhook-bearer-secret

# Allowed domains for inbound email correlation (comma-separated)
HOSTINGER_MAIL_ALLOWED_DOMAINS=overseasjob.in

# =============================================================================
# Scheduled Tasks & Cron Security
# =============================================================================
# Secret key required to authenticate scheduled cron triggers (/api/scheduled/*)
CRON_SECRET=your-cron-shared-secret-key-here

# =============================================================================
# AI Routing & Model Provider Configuration
# =============================================================================
# OpenRouter API key for LLM structured tasks (CV parsing, outreach, reply classification)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini AI API key (injected in AI Studio development container)
GEMINI_API_KEY=

# Model preference override for AI routing
FREELANCEHR_BUILT_IN_MODEL=

# =============================================================================
# Development Forge API (Dev/Preview Container only)
# =============================================================================
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# =============================================================================
# Frontend Client Public Variables (Vite prefixed)
# =============================================================================
VITE_APP_ID=
VITE_AUTH_MODE=
VITE_OAUTH_PORTAL_URL=
