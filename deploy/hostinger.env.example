# First-time production template. Replace blank values privately in hPanel.
# Never commit a completed copy. Leave Hostinger's automatically supplied PORT unchanged.
NODE_ENV=production
APP_BASE_URL=https://freelancehr.overseasjob.in
AUTH_MODE=oidc
VITE_AUTH_MODE=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://freelancehr.overseasjob.in/api/auth/oidc/callback
PRIMARY_OWNER_EMAIL=
OWNER_ONLY_MODE=true
SESSION_SECRET=
CRON_SECRET=

# Use the Node application's actual reachable DB host/user/password, not phpMyAdmin's internal address.
# Shape: mysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
PRIVATE_STORAGE_MODE=local
# Set a persistent absolute directory outside the public web root.
PRIVATE_LOCAL_STORAGE_PATH=

# Configure AI, mailboxes and webhook credentials later when activating those integrations.
