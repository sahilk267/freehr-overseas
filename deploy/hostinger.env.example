# Hostinger production template. Non-secret defaults copied from .env.example.
# Generate a private import file with npm run env:hostinger; never commit the completed file.
# Hostinger supplies PORT. Preview OAuth/Forge credentials do not belong in this deployment.

# Runtime and owner identity
NODE_ENV=production
APP_BASE_URL=https://freelancehr.overseasjob.in
APP_URL=https://freelancehr.overseasjob.in
PRIMARY_OWNER_EMAIL=mohd.aziz.sk@gmail.com
PRIMARY_OWNER_OPEN_ID=
OWNER_ONLY_MODE=true

# Production OIDC login: Google issuer copied from .env.example; real client credentials are still required.
AUTH_MODE=oidc
VITE_AUTH_MODE=oidc
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://freelancehr.overseasjob.in/api/auth/oidc/callback
SESSION_SECRET=
CRON_SECRET=

# Actual Node-accessible MySQL connection; do not reuse the example database/password.
# mysql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Private documents: set a persistent absolute path outside the public web root.
PRIVATE_STORAGE_MODE=local
PRIVATE_LOCAL_STORAGE_PATH=
# Optional S3 backup settings; not needed while storage mode is local.
STORAGE_BUCKET=freelancehr-private-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

# Mail addresses are intended identities, not proof that the mailboxes exist.
# Hostinger Mail API token and resource IDs must come from the provider.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_FROM_DOMAIN=overseasjob.in
OWNER_MAILBOX=owner.fl@overseasjob.in
HOSTINGER_MAILBOX_OWNER_ADDRESS=owner.fl@overseasjob.in
HOSTINGER_MAILBOX_OWNER_ID=
CLIENTS_MAILBOX=clients.fl@overseasjob.in
HOSTINGER_MAILBOX_CLIENTS_ADDRESS=clients.fl@overseasjob.in
HOSTINGER_MAILBOX_CLIENTS_ID=
TALENT_MAILBOX=talent.fl@overseasjob.in
HOSTINGER_MAILBOX_TALENT_ADDRESS=talent.fl@overseasjob.in
HOSTINGER_MAILBOX_TALENT_ID=
INTERVIEWS_MAILBOX=interviews.fl@overseasjob.in
HOSTINGER_MAILBOX_INTERVIEWS_ADDRESS=interviews.fl@overseasjob.in
HOSTINGER_MAILBOX_INTERVIEWS_ID=
FINANCE_MAILBOX=finance.fl@overseasjob.in
HOSTINGER_MAILBOX_FINANCE_ADDRESS=finance.fl@overseasjob.in
HOSTINGER_MAILBOX_FINANCE_ID=
PRIVACY_MAILBOX=privacy.fl@overseasjob.in
HOSTINGER_MAILBOX_PRIVACY_ADDRESS=privacy.fl@overseasjob.in
HOSTINGER_MAILBOX_PRIVACY_ID=
HOSTINGER_MAIL_WEBHOOK_SECRET=
HOSTINGER_MAIL_ALLOWED_DOMAINS=overseasjob.in

# Optional AI integration; the API key must come from OpenRouter.
OPENROUTER_API_KEY=
FREELANCEHR_BUILT_IN_MODEL=
